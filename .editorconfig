root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{hpp,cpp,h}]
max_line_length = 100

[*.md]
max_line_length = 100
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[*.csv]
# Data files: do not reformat.
trim_trailing_whitespace = false
insert_final_newline = true

[third_party/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
